# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase / Neon / Railway / local Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/surgeshield"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
# Run: openssl rand -base64 32   to generate a secret
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-32-random-bytes"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get these from console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Get these from console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Inngest ──────────────────────────────────────────────────────────────────
# Get these from app.inngest.com → Manage → Keys
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="signkey-prod-your-signing-key"

# ─── Email (optional — swap simulated sender for real delivery) ───────────────
# Resend: https://resend.com
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="noreply@yourdomain.com"

# ─── Ops Alerting (optional) ─────────────────────────────────────────────────
# Discord or Slack webhook URL for automated SRE alerts
OPS_WEBHOOK_URL=""
